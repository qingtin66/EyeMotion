{
  "name": "eyemotion",
  "version": "1.1.2",
  "description": "EyeMotion - Multi-platform visual tracking training",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ui scripts",
    "format": "prettier --write \"ui/**/*.{ts,js}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"ui/**/*.{ts,js}\" \"scripts/**/*.mjs\"",
    "check:version": "node scripts/check-version.mjs",
    "build:windows": "npm run build && cargo tauri build --target x86_64-pc-windows-msvc",
    "build:macos": "npm run build && cargo tauri build --target universal-apple-darwin",
    "build:linux": "npm run build && cargo tauri build --target x86_64-unknown-linux-gnu",
    "build:android": "npm run build && cargo tauri android build",
    "build:ios": "npm run build && cargo tauri ios build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.9.6",
    "@eslint/js": "^9.13.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  }
}
